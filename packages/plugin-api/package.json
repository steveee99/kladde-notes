{
  "name": "@kladde/plugin-api",
  "version": "1.3.0",
  "description": "The only interface between Kladde and its build-time plugins (own SemVer, independent of the app version)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@types/express": "*",
    "@types/node": "*",
    "react": "^18.3.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.9",
    "@types/react": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
