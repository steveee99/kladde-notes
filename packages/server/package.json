  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.1"
