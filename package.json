{
  "name": "kladde",
  "version": "2.0.1",
  "description": "Self-hosted, offline-first Markdown notes app (PWA)",
  "private": true,
  "license": "MIT",
  "author": "Stefan Stumpf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steveee99/kladde-notes.git"
  },
  "bugs": {
    "url": "https://github.com/steveee99/kladde-notes/issues"
  },
  "homepage": "https://github.com/steveee99/kladde-notes#readme",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"shared,server,client\" -c \"blue,green,magenta\" \"npm run build:watch --workspace=packages/shared\" \"npm run dev --workspace=packages/server\" \"npm run dev --workspace=packages/client\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/server && npm run build --workspace=packages/client",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:exe": "node scripts/build-desktop.mjs --win",
    "test": "npm run test --workspace=packages/shared && npm run test --workspace=packages/server",
    "cli": "node packages/server/dist/cli.js",
    "import": "node packages/server/dist/importCli.js",
    "release": "node scripts/release.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "deepmerge": "file:vendor/deepmerge",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "glob": "^14.0.2",
    "deepmerge": "$deepmerge",
    "katex": "^0.18.10",
    "lodash-es": "^4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^3.3.20"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
