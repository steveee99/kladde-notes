{
  "name": "kladde-plugin-logbook",
  "version": "0.1.0",
  "private": true,
  "description": "Example build-time plugin for Kladde: an encrypted logbook with its own tables, routes, page, navigation entry and settings",
  "type": "module",
  "kladde": {
    "id": "logbook",
    "app": ">=2.27.0 <4",
    "defaultEnabled": false
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "@kladde/plugin-api": "^1.3.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@kladde/plugin-api": "*",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.9",
    "@types/react": "^19.3.1",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
